# --------------------------------------------
# Supported Symbols
# --------------------------------------------

SYMBOLS = {

    "NIFTY":"^NSEI",

    "BANKNIFTY":"^NSEBANK",

    "SENSEX":"^BSESN",

    "FINNIFTY":"NIFTY_FIN_SERVICE.NS",

    "MIDCPNIFTY":"NIFTY_MID_SELECT.NS",

    "RELIANCE":"RELIANCE.NS",

    "TCS":"TCS.NS",

    "INFY":"INFY.NS",

    "HDFCBANK":"HDFCBANK.NS",

    "ICICIBANK":"ICICIBANK.NS",

    "SBIN":"SBIN.NS"

}


# --------------------------------------------
# Timeframes
# --------------------------------------------

TIMEFRAMES={

"1m":"1d",

"5m":"5d",

"15m":"1mo",

"30m":"1mo",

"1h":"3mo",

"1d":"1y"

}


# --------------------------------------------
# Download Historical Data
# --------------------------------------------

@st.cache_data(ttl=30)

def get_history(symbol,
                interval="15m"):

    ticker=SYMBOLS.get(symbol,symbol)

    period=TIMEFRAMES.get(interval,"1mo")

    df=yf.download(

        ticker,

        interval=interval,

        period=period,

        progress=False,

        auto_adjust=True

    )

    if df.empty:

        return pd.DataFrame()

    df=df.reset_index()

    return df


# --------------------------------------------
# Latest Price
# --------------------------------------------

@st.cache_data(ttl=5)

def get_ltp(symbol):

    ticker=SYMBOLS.get(symbol,symbol)

    obj=yf.Ticker(ticker)

    info=obj.fast_info

    return{

        "price":round(info["lastPrice"],2),

        "previous_close":round(info["previousClose"],2),

        "day_high":round(info["dayHigh"],2),

        "day_low":round(info["dayLow"],2),

        "volume":info["lastVolume"]

    }


# --------------------------------------------
# Percentage Change
# --------------------------------------------

def percentage_change(price,previous):

    return round(((price-previous)/previous)*100,2)


# --------------------------------------------
# Live Snapshot
# --------------------------------------------

def market_snapshot(symbol):

    live=get_ltp(symbol)

    chg=percentage_change(

        live["price"],

        live["previous_close"]

    )
