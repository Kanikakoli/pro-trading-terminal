import yfinance as yf
import pandas as pd
import streamlit as st

# -------------------------------------------------------
# SYMBOL MAPPING
# -------------------------------------------------------

SYMBOLS = {
    "NIFTY": "^NSEI",
    "BANKNIFTY": "^NSEBANK",
    "SENSEX": "^BSESN",
    "FINNIFTY": "NIFTY_FIN_SERVICE.NS",
    "INDIA VIX": "^INDIAVIX"
}


# -------------------------------------------------------
# LIVE MARKET SNAPSHOT
# -------------------------------------------------------

@st.cache_data(ttl=10)
def get_live_market_data():

    data = {}

    for name, ticker in SYMBOLS.items():

        try:

            tk = yf.Ticker(ticker)

            info = tk.fast_info

            last = round(info.last_price, 2)
            prev = round(info.previous_close, 2)

            change = round(last - prev, 2)

            pct = round((change / prev) * 100, 2)

            data[name] = {

                "price": last,
                "change": change,
                "percent": pct

            }

        except Exception:

            data[name] = {

                "price": None,
                "change": None,
                "percent": None

            }

    return data


# -------------------------------------------------------
# HISTORICAL DATA
# -------------------------------------------------------

@st.cache_data(ttl=30)
def get_historical_data(
    symbol="NIFTY",
    period="3mo",
    interval="15m"
):

    ticker = SYMBOLS.get(symbol, "^NSEI")

    df = yf.download(
        ticker,
        period=period,
        interval=interval,
        progress=False,
        auto_adjust=True
    )

    if df.empty:
        return None

    df.reset_index(inplace=True)

    if "Datetime" in df.columns:
        df.rename(columns={"Datetime": "Date"}, inplace=True)

    if "Date" not in df.columns:
        df.rename(columns={"index": "Date"}, inplace=True)

    return df


# -------------------------------------------------------
# MARKET STATUS
# -------------------------------------------------------

def market_status():

    from datetime import datetime

    now = datetime.now()

    if now.weekday() >= 5:
        return "Market Closed"

    if 9 <= now.hour < 15:
        return "Market Open"

    return "Market Closed"
